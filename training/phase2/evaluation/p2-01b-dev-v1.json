      "checks": [
        { "kind": "css_declaration", "selector": "button:hover", "property": "background-color", "value": "#234" }
      ]
    },
    {
      "id": "p2dev-css-07-visually-hidden", "language": "css", "difficulty": "edge",
      "request": "Create a .visually-hidden utility that clips content to a 1px box, removes it from normal flow, and hides overflow.",
      "checks": [
        { "kind": "css_declaration", "selector": ".visually-hidden", "property": "position", "value": "absolute" },
        { "kind": "css_declaration", "selector": ".visually-hidden", "property": "width", "value": "1px" },
        { "kind": "css_declaration", "selector": ".visually-hidden", "property": "overflow", "value": "hidden" }
      ]
    },
    {
      "id": "p2dev-css-08-sticky-header", "language": "css", "difficulty": "edge",
      "request": "Make .site-header stick to the top of its scroll container with a white background.",
      "checks": [
        { "kind": "css_declaration", "selector": ".site-header", "property": "position", "value": "sticky" },
        { "kind": "css_declaration", "selector": ".site-header", "property": "top", "value": "0" },
        { "kind": "css_declaration", "selector": ".site-header", "property": "background-color", "value": "white" }
      ]
    },
    {
      "id": "p2dev-css-09-expanded-panel", "language": "css", "difficulty": "edge",
      "request": "When a button has aria-expanded=true, hide the adjacent .panel using display none.",
      "checks": [
