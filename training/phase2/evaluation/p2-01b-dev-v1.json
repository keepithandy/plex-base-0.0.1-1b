        { "kind": "html_element", "tag": "a", "attrs": { "href": "/" } },
        { "kind": "html_element", "tag": "span", "attrs": { "aria-current": "page" } },
        { "kind": "html_text_contains", "text": "Settings" }
      ]
    },

    {
      "id": "p2dev-css-01-card-flex", "language": "css", "difficulty": "basic",
      "request": "Style .card as a flex container with a 1rem gap and 1rem internal padding.",
      "checks": [
        { "kind": "css_declaration", "selector": ".card", "property": "display", "value": "flex" },
        { "kind": "css_declaration", "selector": ".card", "property": "gap", "value": "1rem" },
        { "kind": "css_declaration", "selector": ".card", "property": "padding", "value": "1rem" }
      ]
    },
    {
      "id": "p2dev-css-02-auto-grid", "language": "css", "difficulty": "basic",
      "request": "Make .gallery a responsive grid using auto-fit columns with a 16rem minimum and a 1fr maximum, with a 1rem gap.",
      "checks": [
        { "kind": "css_declaration", "selector": ".gallery", "property": "display", "value": "grid" },
        { "kind": "css_declaration", "selector": ".gallery", "property": "grid-template-columns", "value": "repeat(auto-fit, minmax(16rem, 1fr))" },
        { "kind": "css_declaration", "selector": ".gallery", "property": "gap", "value": "1rem" }
      ]
    },
    {
      "id": "p2dev-css-03-keyboard-focus", "language": "css", "difficulty": "basic",
      "request": "Give buttons a visible keyboard-focus outline with a 3px solid currentColor outline and a 3px offset.",
      "checks": [
        { "kind": "css_declaration", "selector": "button:focus-visible", "property": "outline", "value": "3px solid currentColor" },
        { "kind": "css_declaration", "selector": "button:focus-visible", "property": "outline-offset", "value": "3px" }
      ]
    },
    {
      "id": "p2dev-css-04-fluid-heading", "language": "css", "difficulty": "basic",
