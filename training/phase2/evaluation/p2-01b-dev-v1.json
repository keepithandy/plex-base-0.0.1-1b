      "checks": [
        { "kind": "css_declaration", "selector": "h1", "property": "font-size", "value": "clamp(1.5rem, 4vw, 2.5rem)" }
      ]
    },
    {
      "id": "p2dev-css-05-responsive-image", "language": "css", "difficulty": "basic",
