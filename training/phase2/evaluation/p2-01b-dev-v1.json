        { "kind": "css_declaration", "selector": ".toolbar", "property": "gap", "value": "0.5rem" }
      ]
    },

    {
      "id": "p2dev-js-01-clamp", "language": "javascript", "difficulty": "basic",
      "request": "Write clamp(value, minimum, maximum), returning the value bounded inclusively by minimum and maximum.",
      "checks": [
        { "kind": "js_function", "name": "clamp" },
        { "kind": "contains", "text": "Math.min" },
        { "kind": "contains", "text": "Math.max" }
      ]
    },
    {
