{
  "schemaVersion": 1,
  "setId": "p2-01b-dev-v1",
  "kind": "development",
  "provenance": "owner-authored",
  "outputContracts": {
    "html": "Return one semantic HTML fragment only. Do not include Markdown fences or explanations.",
    "css": "Return CSS rules only. Use the requested selector and declarations. Do not include HTML, Markdown fences, or explanations.",
    "javascript": "Return one JavaScript function only. Do not include Markdown fences or explanations."
  },
  "inferenceDefaults": {
    "temperature": 0.0,
    "seed": 1337,
    "maxNewTokens": { "html": 192, "css": 128, "javascript": 192 },
    "promptTemplateVersion": "plex-coding-task-v1"
  },
  "tasks": [
    {
      "id": "p2dev-html-01-primary-navigation", "language": "html", "difficulty": "basic",
      "request": "Create a primary navigation landmark named Primary with links to Home and Projects.",
      "checks": [
        { "kind": "html_element", "tag": "nav", "attrs": { "aria-label": "Primary" } },
        { "kind": "html_element", "tag": "a", "attrs": { "href": "/" }, "minimumCount": 1 },
        { "kind": "html_text_contains", "text": "Projects" }
      ]
    },
    {
      "id": "p2dev-html-02-email-form", "language": "html", "difficulty": "basic",
      "request": "Create a labeled email field that is required and a submit button labeled Join.",
      "checks": [
        { "kind": "html_element", "tag": "label", "attrs": { "for": "email" } },
        { "kind": "html_element", "tag": "input", "attrs": { "id": "email", "type": "email", "required": null } },
        { "kind": "html_element", "tag": "button", "attrs": { "type": "submit" } },
        { "kind": "html_text_contains", "text": "Join" }
      ]
    },
    {
      "id": "p2dev-html-03-article-date", "language": "html", "difficulty": "basic",
      "request": "Create an article with a heading, a short paragraph, and a publication time using a machine-readable datetime.",
      "checks": [
        { "kind": "html_element", "tag": "article" },
        { "kind": "html_element", "tag": "h2" },
        { "kind": "html_element", "tag": "time", "attrs": { "datetime": null } },
        { "kind": "html_text_contains", "text": "article" }
      ]
    },
    {
      "id": "p2dev-html-04-live-status", "language": "html", "difficulty": "basic",
      "request": "Create a status message with id save-status and a button whose aria-describedby points to it.",
      "checks": [
        { "kind": "html_element", "tag": "p", "attrs": { "id": "save-status", "role": "status" } },
        { "kind": "html_element", "tag": "button", "attrs": { "aria-describedby": "save-status" } }
      ]
    },
    {
      "id": "p2dev-html-05-three-steps", "language": "html", "difficulty": "basic",
      "request": "Create an ordered list containing three steps for saving a document.",
      "checks": [
        { "kind": "html_element", "tag": "ol" },
        { "kind": "html_element", "tag": "li", "minimumCount": 3 },
        { "kind": "html_text_contains", "text": "save" }
      ]
    },
    {
      "id": "p2dev-html-06-figure-caption", "language": "html", "difficulty": "basic",
      "request": "Create a figure with an image at /images/garden.jpg and a descriptive alt attribute, followed by a caption.",
      "checks": [
        { "kind": "html_element", "tag": "figure" },
        { "kind": "html_element", "tag": "img", "attrs": { "src": "/images/garden.jpg", "alt": null } },
        { "kind": "html_element", "tag": "figcaption" }
      ]
    },
    {
      "id": "p2dev-html-07-details-summary", "language": "html", "difficulty": "basic",
      "request": "Create a disclosure widget with a details element, a summary labeled Shipping, and explanatory content.",
      "checks": [
        { "kind": "html_element", "tag": "details" },
        { "kind": "html_element", "tag": "summary" },
        { "kind": "html_text_contains", "text": "Shipping" }
      ]
    },
    {
      "id": "p2dev-html-08-data-table", "language": "html", "difficulty": "edge",
      "request": "Create a small table with a caption, two column headers scoped to columns, and one data row.",
      "checks": [
        { "kind": "html_element", "tag": "table" },
        { "kind": "html_element", "tag": "caption" },
        { "kind": "html_element", "tag": "th", "attrs": { "scope": "col" }, "minimumCount": 2 },
        { "kind": "html_element", "tag": "tbody" }
      ]
    },
    {
      "id": "p2dev-html-09-checkbox-fieldset", "language": "html", "difficulty": "edge",
      "request": "Create a fieldset with a legend labeled Notifications and one labeled checkbox with id weekly.",
      "checks": [
        { "kind": "html_element", "tag": "fieldset" },
        { "kind": "html_text_contains", "text": "Notifications" },
        { "kind": "html_element", "tag": "input", "attrs": { "id": "weekly", "type": "checkbox" } },
        { "kind": "html_element", "tag": "label", "attrs": { "for": "weekly" } }
      ]
    },
    {
      "id": "p2dev-html-10-breadcrumbs", "language": "html", "difficulty": "edge",
      "request": "Create breadcrumb navigation named Breadcrumb with an ordered list and a current-page item for Settings.",
      "checks": [
