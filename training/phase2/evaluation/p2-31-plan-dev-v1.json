      "language": "css",
      "difficulty": "basic",
      "request": "The gallery should use a responsive grid with auto-fit columns, a 16rem minimum, a 1fr maximum, and a 1rem gap. Return the normalized plan, not CSS.",
      "expectedPlan": {
        "action": "modify",
        "targetKind": "css-rule",
