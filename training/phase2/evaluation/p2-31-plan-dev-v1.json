{
  "schemaVersion": 1,
  "setId": "p2-31-plan-dev-v1",
  "kind": "development",
  "provenance": "project-authored-development",
  "purpose": "Measure whether Plex Nano can normalize unseen repository-style HTML/CSS/JavaScript requests into bounded semantic edit plans while deterministic Plex Code retains exact repository resolution and mutation.",
  "planSchemaVersion": "plex-structured-edit-plan-v1",
  "inferenceDefaults": {
    "temperature": 0,
    "seed": 1337,
    "maxNewTokens": 256,
    "promptTemplateVersion": "plex-structured-plan-v1"
  },
  "gate": {
    "minimumPassed": 12,
    "minimumPerLanguage": 3,
    "minimumSchemaValid": 15
  },
  "tasks": [
    {
      "id": "p231-html-01-primary-nav",
      "language": "html",
      "difficulty": "basic",
      "request": "In an existing site header, modify the primary navigation so it is explicitly labeled Main and contains a current-page state for the active destination. Do not choose a file or exact selector; describe the semantic edit plan only.",
      "expectedPlan": {
        "action": "modify",
        "targetKind": "html-element",
        "targetRole": "primary-navigation",
        "constraints": [
          {
            "kind": "element",
            "key": "semantic-element",
            "value": "nav"
          },
          {
            "kind": "attribute",
            "key": "aria-label",
            "value": "Main"
          },
          {
            "kind": "state",
            "key": "aria-current",
            "value": "page"
          }
        ],
        "hintKeywords": [
          "navigation",
          "active"
        ]
      }
    },
    {
      "id": "p231-html-02-email-field",
      "language": "html",
      "difficulty": "basic",
      "request": "A signup form needs an accessible required email input with a visible label. Produce the semantic edit plan without naming a file or assuming an exact id.",
      "expectedPlan": {
        "action": "modify",
        "targetKind": "html-element",
        "targetRole": "email-field",
        "constraints": [
          {
            "kind": "element",
            "key": "input-type",
            "value": "email"
          },
          {
            "kind": "attribute",
            "key": "required",
            "value": "true"
          },
          {
            "kind": "behavior",
            "key": "label-association",
            "value": "required"
          }
        ],
        "hintKeywords": [
          "email",
          "label"
        ]
      }
    },
    {
      "id": "p231-html-03-status-message",
      "language": "html",
      "difficulty": "basic",
      "request": "The save workflow needs a status message that assistive technology can announce and a control that refers to that message. Return only a semantic plan.",
      "expectedPlan": {
        "action": "create",
        "targetKind": "html-element",
        "targetRole": "save-status",
        "constraints": [
          {
            "kind": "attribute",
            "key": "role",
            "value": "status"
          },
          {
            "kind": "behavior",
            "key": "described-by-link",
            "value": "required"
          }
        ],
        "hintKeywords": [
          "status",
          "save"
        ]
      }
    },
    {
