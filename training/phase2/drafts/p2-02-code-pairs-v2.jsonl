{"schemaVersion":1,"id":"pair-javascript-array-search-positive","language":"javascript","sourceFamilyId":"plex-code-pairs-javascript-v2","splitGroupId":"javascript-array-search","provenance":"codex-authored-local-training-candidate","approvalStatus":"pending-owner-review","request":"Write firstPositive(values), returning the first finite number greater than zero in an array. Ignore other values. Return null when absent or input is not an array.","solution":"function firstPositive(values) {\n  if (!Array.isArray(values)) return null;\n  const found = values.find(value => Number.isFinite(value) && value > 0);\n  return found === undefined ? null : found;\n}","checks":[{"kind":"js_function","name":"firstPositive"},{"kind":"contains","text":"Array.isArray(values)"},{"kind":"contains","text":"values.find"},{"kind":"contains","text":"Number.isFinite(value) && value > 0"},{"kind":"contains","text":"found === undefined ? null : found"}],"behaviorReviewCases":[{"arguments":[[-2,"4",0,3,8]],"expected":3},{"arguments":[[]],"expected":null},{"arguments":[null],"expected":null}],"candidateSplit":"validation"}
{"schemaVersion":1,"id":"pair-javascript-array-search-text","language":"javascript","sourceFamilyId":"plex-code-pairs-javascript-v2","splitGroupId":"javascript-array-search","provenance":"codex-authored-local-training-candidate","approvalStatus":"pending-owner-review","request":"Write firstNonblank(values), finding the first string with non-whitespace content in an array and returning it trimmed. Return an empty string when absent or input is not an array.","solution":"function firstNonblank(values) {\n  if (!Array.isArray(values)) return \"\";\n  const found = values.find(value => typeof value === \"string\" && value.trim().length > 0);\n  return found === undefined ? \"\" : found.trim();\n}","checks":[{"kind":"js_function","name":"firstNonblank"},{"kind":"contains","text":"Array.isArray(values)"},{"kind":"contains","text":"values.find"},{"kind":"contains","text":"value.trim().length > 0"},{"kind":"contains","text":"found.trim()"}],"behaviorReviewCases":[{"arguments":[[null," "," ok ","later"]],"expected":"ok"},{"arguments":[[]],"expected":""},{"arguments":["ok"],"expected":""}],"candidateSplit":"validation"}
{"schemaVersion":1,"id":"pair-javascript-calendar-february","language":"javascript","sourceFamilyId":"plex-code-pairs-javascript-v2","splitGroupId":"javascript-calendar","provenance":"codex-authored-local-training-candidate","approvalStatus":"pending-owner-review","request":"Write daysInFebruary(year) for positive integer Gregorian years: 29 in leap years, otherwise 28. Return null for invalid years.","solution":"function daysInFebruary(year) {\n  if (!Number.isInteger(year) || year <= 0) return null;\n  const leap = year % 400 === 0 || (year % 4 === 0 && year % 100 !== 0);\n  return leap ? 29 : 28;\n}","checks":[{"kind":"js_function","name":"daysInFebruary"},{"kind":"contains","text":"Number.isInteger(year)"},{"kind":"contains","text":"year % 400 === 0"},{"kind":"contains","text":"year % 100 !== 0"},{"kind":"contains","text":"leap ? 29 : 28"}],"behaviorReviewCases":[{"arguments":[2000],"expected":29},{"arguments":[1900],"expected":28},{"arguments":[2023],"expected":28},{"arguments":[-1],"expected":null}],"candidateSplit":"train"}
{"schemaVersion":1,"id":"pair-javascript-calendar-leap","language":"javascript","sourceFamilyId":"plex-code-pairs-javascript-v2","splitGroupId":"javascript-calendar","provenance":"codex-authored-local-training-candidate","approvalStatus":"pending-owner-review","request":"Write isLeapYear(year) for the Gregorian calendar. Positive integer years divisible by 400, or by 4 but not 100, are leap years; invalid years return false.","solution":"function isLeapYear(year) {\n  return Number.isInteger(year) && year > 0 && (year % 400 === 0 || (year % 4 === 0 && year % 100 !== 0));\n}","checks":[{"kind":"js_function","name":"isLeapYear"},{"kind":"contains","text":"Number.isInteger(year)"},{"kind":"contains","text":"year > 0"},{"kind":"contains","text":"year % 400 === 0"},{"kind":"contains","text":"year % 100 !== 0"}],"behaviorReviewCases":[{"arguments":[2000],"expected":true},{"arguments":[1900],"expected":false},{"arguments":[2024],"expected":true},{"arguments":[0],"expected":false}],"candidateSplit":"train"}
{"schemaVersion":1,"id":"pair-javascript-parity-even","language":"javascript","sourceFamilyId":"plex-code-pairs-javascript-v2","splitGroupId":"javascript-parity","provenance":"codex-authored-local-training-candidate","approvalStatus":"pending-owner-review","request":"Write isEven(value), returning true only for even integers. Return false for non-integers or non-number inputs.","solution":"function isEven(value) {\n  return Number.isInteger(value) && value % 2 === 0;\n}","checks":[{"kind":"js_function","name":"isEven"},{"kind":"contains","text":"Number.isInteger(value)"},{"kind":"contains","text":"value % 2 === 0"}],"behaviorReviewCases":[{"arguments":[-4],"expected":true},{"arguments":[3],"expected":false},{"arguments":[2.5],"expected":false}],"candidateSplit":"train"}
{"schemaVersion":1,"id":"pair-javascript-parity-odd","language":"javascript","sourceFamilyId":"plex-code-pairs-javascript-v2","splitGroupId":"javascript-parity","provenance":"codex-authored-local-training-candidate","approvalStatus":"pending-owner-review","request":"Write isOdd(value), returning true only for odd integers, including negative odd integers. Return false for other inputs.","solution":"function isOdd(value) {\n  return Number.isInteger(value) && Math.abs(value % 2) === 1;\n}","checks":[{"kind":"js_function","name":"isOdd"},{"kind":"contains","text":"Number.isInteger(value)"},{"kind":"contains","text":"Math.abs(value % 2) === 1"}],"behaviorReviewCases":[{"arguments":[-3],"expected":true},{"arguments":[4],"expected":false},{"arguments":["3"],"expected":false}],"candidateSplit":"train"}
{"schemaVersion":1,"id":"pair-javascript-rectangle-area","language":"javascript","sourceFamilyId":"plex-code-pairs-javascript-v2","splitGroupId":"javascript-rectangle","provenance":"codex-authored-local-training-candidate","approvalStatus":"pending-owner-review","request":"Write rectangleArea(width, height). Return their product for finite nonnegative numbers; otherwise return null.","solution":"function rectangleArea(width, height) {\n  if (!Number.isFinite(width) || !Number.isFinite(height) || width < 0 || height < 0) return null;\n  return width * height;\n}","checks":[{"kind":"js_function","name":"rectangleArea"},{"kind":"contains","text":"Number.isFinite(width)"},{"kind":"contains","text":"Number.isFinite(height)"},{"kind":"contains","text":"width < 0 || height < 0"},{"kind":"contains","text":"width * height"}],"behaviorReviewCases":[{"arguments":[3,4],"expected":12},{"arguments":[0,5],"expected":0},{"arguments":[-1,4],"expected":null}],"candidateSplit":"train"}
{"schemaVersion":1,"id":"pair-javascript-rectangle-perimeter","language":"javascript","sourceFamilyId":"plex-code-pairs-javascript-v2","splitGroupId":"javascript-rectangle","provenance":"codex-authored-local-training-candidate","approvalStatus":"pending-owner-review","request":"Write rectanglePerimeter(width, height). Return twice the sum of the sides for finite nonnegative numbers; otherwise return null.","solution":"function rectanglePerimeter(width, height) {\n  if (!Number.isFinite(width) || !Number.isFinite(height) || width < 0 || height < 0) return null;\n  return 2 * (width + height);\n}","checks":[{"kind":"js_function","name":"rectanglePerimeter"},{"kind":"contains","text":"Number.isFinite(width)"},{"kind":"contains","text":"Number.isFinite(height)"},{"kind":"contains","text":"width < 0 || height < 0"},{"kind":"contains","text":"2 * (width + height)"}],"behaviorReviewCases":[{"arguments":[3,4],"expected":14},{"arguments":[0,5],"expected":10},{"arguments":["3",4],"expected":null}],"candidateSplit":"train"}
{"schemaVersion":1,"id":"pair-javascript-repetition-divider","language":"javascript","sourceFamilyId":"plex-code-pairs-javascript-v2","splitGroupId":"javascript-repetition","provenance":"codex-authored-local-training-candidate","approvalStatus":"pending-owner-review","request":"Write makeDivider(symbol, width), repeating a string whose JavaScript length is exactly 1 for integer widths from 0 through 64. Return an empty string for invalid arguments.","solution":"function makeDivider(symbol, width) {\n  if (typeof symbol !== \"string\" || symbol.length !== 1 || !Number.isInteger(width) || width < 0 || width > 64) return \"\";\n  return symbol.repeat(width);\n}","checks":[{"kind":"js_function","name":"makeDivider"},{"kind":"contains","text":"symbol.length !== 1"},{"kind":"contains","text":"Number.isInteger(width)"},{"kind":"contains","text":"width > 64"},{"kind":"contains","text":"symbol.repeat(width)"}],"behaviorReviewCases":[{"arguments":["-",4],"expected":"----"},{"arguments":["ab",4],"expected":""},{"arguments":["-",0],"expected":""}],"candidateSplit":"validation"}
{"schemaVersion":1,"id":"pair-javascript-repetition-text","language":"javascript","sourceFamilyId":"plex-code-pairs-javascript-v2","splitGroupId":"javascript-repetition","provenance":"codex-authored-local-training-candidate","approvalStatus":"pending-owner-review","request":"Write repeatText(text, count). Repeat a string count times for integer counts from 0 through 100. Return an empty string for invalid arguments.","solution":"function repeatText(text, count) {\n  if (typeof text !== \"string\" || !Number.isInteger(count) || count < 0 || count > 100) return \"\";\n  return text.repeat(count);\n}","checks":[{"kind":"js_function","name":"repeatText"},{"kind":"contains","text":"typeof text !== \"string\""},{"kind":"contains","text":"Number.isInteger(count)"},{"kind":"contains","text":"count > 100"},{"kind":"contains","text":"text.repeat(count)"}],"behaviorReviewCases":[{"arguments":["ab",3],"expected":"ababab"},{"arguments":["ab",0],"expected":""},{"arguments":["ab",101],"expected":""}],"candidateSplit":"validation"}
{"schemaVersion":1,"id":"pair-javascript-temperature-celsius","language":"javascript","sourceFamilyId":"plex-code-pairs-javascript-v2","splitGroupId":"javascript-temperature","provenance":"codex-authored-local-training-candidate","approvalStatus":"pending-owner-review","request":"Write toCelsius(fahrenheit), converting a finite Fahrenheit number to Celsius. Return null for non-number or non-finite input.","solution":"function toCelsius(fahrenheit) {\n  if (!Number.isFinite(fahrenheit)) return null;\n  return (fahrenheit - 32) * 5 / 9;\n}","checks":[{"kind":"js_function","name":"toCelsius"},{"kind":"contains","text":"Number.isFinite(fahrenheit)"},{"kind":"contains","text":"(fahrenheit - 32) * 5 / 9"}],"behaviorReviewCases":[{"arguments":[32],"expected":0},{"arguments":[212],"expected":100},{"arguments":[null],"expected":null}],"candidateSplit":"train"}
