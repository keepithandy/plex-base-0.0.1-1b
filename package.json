{
  "name": "plex-code-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Plex: a lightweight local repository implementation CLI",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "bin": {
    "plex": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "prompts",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/integration/*.test.mjs tests/unit/*.test.mjs",
    "start": "node dist/cli/main.js",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "diff": "9.0.0",
    "ignore": "7.0.5"
  }
}
